# TensorCanvas backend — environment
#
# The server reads these from the process environment (os.environ). Either
# `export` them before launching, or set them inline. There are NO secrets.
#
#   HOST=0.0.0.0 BACKEND_PORT=9000 uv run tensorcanvas-server

# Interface to bind. Keep 127.0.0.1 for local-only (recommended); use 0.0.0.0
# only if you understand the exposure (see SECURITY.md).
HOST=127.0.0.1

# Port to listen on (PORT is used as a fallback if BACKEND_PORT is unset).
BACKEND_PORT=8000
# PORT=8000

# Uvicorn auto-reload on code change. 1 = on (dev), 0 = off (demo/prod).
RELOAD=1

# Browser origins allowed by CORS (comma-separated). Defaults to the dev
# frontend on :3000. Add your frontend origin if you change its host/port.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where torchvision caches downloaded pretrained weights (AlexNet ~233 MB).
# TORCH_HOME=~/.cache/torch
