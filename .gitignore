# ── OS / editor cruft ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── Environment (never commit real env files; .env.example IS committed) ───────
.env
.env.local
.env.*.local

# ── Auto-generated by `next dev` on every run (not source) ─────────────────────
client/AGENTS.md

# ── Frontend (regenerated by `yarn install` / `next build`) ────────────────────
client/node_modules/
client/.next/
client/out/
client/.pnp.*
client/.yarn/*
!client/.yarn/patches
!client/.yarn/plugins
!client/.yarn/releases
!client/.yarn/versions

# ── Backend (regenerated by `uv sync`) ─────────────────────────────────────────
server/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage

# ── Large generated sample data (regenerable via sample-data/generate.py) ──────
sample-data/*.csv

# ── Local-only git-history tooling — keep OUT of the published repo ────────────
/commit-split.csv
/rewrite-history.sh
/push-and-pr.sh
/publish-to-github.sh

# Local-only design mockups (not part of the app)
/design/
