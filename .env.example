# TensorCanvas — environment (root / dev.sh)
#
# Copy to `.env` only if you want to override the defaults below, then either
# `export` these before running ./dev.sh, or set them inline, e.g.:
#   FRONTEND_PORT=4000 BACKEND_PORT=9000 ./dev.sh
#
# There are NO secrets in this project. Everything here is a host/port.

# Port the Next.js frontend listens on.
FRONTEND_PORT=3000

# Port the FastAPI backend listens on.
BACKEND_PORT=8000

# URL dev.sh polls to know the backend is ready (defaults to the backend /health).
# BACKEND_HEALTH_URL=http://localhost:8000/health
