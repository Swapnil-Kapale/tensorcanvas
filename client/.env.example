# TensorCanvas frontend — environment
#
# Copy to `.env.local` and edit if your backend is not on http://localhost:8000.
# `.env.local` is git-ignored. There are NO secrets here.
#
# NOTE: the NEXT_PUBLIC_ prefix is REQUIRED — only NEXT_PUBLIC_* variables are
# exposed to browser code. Without it, the client cannot read this value.

# Base URL of the TensorCanvas backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000
